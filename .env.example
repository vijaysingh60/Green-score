# GREENScore Hyderabad: environment template (hackathon MVP).
# Copy to `.env` at the repo root. The API, the web app and the scripts all read this one file.
# Never commit real credentials.

NODE_ENV=development

# --- API (apps/api) ---------------------------------------------------------
API_PORT=4000
# `directConnection=true` works with a standalone mongod and a single-node replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/greenscore?directConnection=true
# Atlas (mongodb+srv://) only: DNS server(s) used to resolve the SRV record. Fixes
# "querySrv ECONNREFUSED" on networks whose DNS can't resolve SRV. Default 8.8.8.8; empty = off.
# MONGODB_DNS_SERVERS=8.8.8.8
# Comma-separated browser origins allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Python ML service (apps/ml). If it is down the API falls back to a simulated prediction.
ML_SERVICE_URL=http://localhost:8001
# MVP admin gate: a shared DEMO passcode, not real authentication. Change it for public demos.
ADMIN_PASSCODE=greenscore-admin

# --- Web (apps/web) ---------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- ML service (apps/ml) ---------------------------------------------------
ML_PORT=8001
