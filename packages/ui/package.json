    "@greenscore/types": "*",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
