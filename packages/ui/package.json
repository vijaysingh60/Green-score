{
  "name": "@greenscore/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Generic, reusable React UI components and design tokens (Tailwind CSS v4).",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
